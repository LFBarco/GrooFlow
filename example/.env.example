# Copie este archivo a .env y ajuste los valores para producción.
# Nunca suba .env al repositorio (debe estar en .gitignore).

# Supabase (proyecto clínica veterinaria)
VITE_SUPABASE_PROJECT_ID=su_project_id
VITE_SUPABASE_ANON_KEY=su_anon_key_publica

# Opcional: URL completa de las Edge Functions si usa un proxy o dominio custom
# VITE_SUPABASE_FUNCTIONS_URL=https://su_project_id.supabase.co/functions/v1/make-server-674cc941

# E2E Playwright (no commitear credenciales reales)
# E2E_EMAIL=usuario@empresa.com
# E2E_PASSWORD=contraseña_de_prueba
# Alias aceptados: PLAYWRIGHT_ADMIN_EMAIL / PLAYWRIGHT_ADMIN_PASSWORD
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173
# PLAYWRIGHT_SKIP_WEBSERVER=1  (si ya tiene `npm run dev` en 5173)

# Solo desarrollo: login demo offline (admin@grooflow.com / 123456)
# Requiere VITE_BACKEND=local O VITE_ALLOW_DEMO_LOGIN=true en dev (nunca en producción)
# VITE_ALLOW_DEMO_LOGIN=true
