# Backend
#   supabase — Vercel + Supabase (histórico)
#   rest     — Hostinger PHP en /grooflow/api (producción Gestión)
#   local    — solo localStorage
VITE_BACKEND=rest
VITE_GROOFLOW_API_URL=/grooflow/api

# Supabase (solo si VITE_BACKEND=supabase)
# VITE_SUPABASE_PROJECT_ID=su_project_id
# VITE_SUPABASE_ANON_KEY=su_anon_key_publica
# VITE_SUPABASE_FUNCTIONS_URL=https://su_project_id.supabase.co/functions/v1/make-server-674cc941

# Hostinger: SQL de Supabase desactivado (los datos van a grooflow_* en MySQL)
VITE_PRODUCTION_SQL=false
VITE_TRANSACTIONS_SQL=false
VITE_FLEET_SQL=false
VITE_INVENTORY_SQL=false

# E2E Playwright (no commitear credenciales reales)
# E2E_EMAIL=usuario@empresa.com
# E2E_PASSWORD=contraseña_de_prueba
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173/grooflow/
# PLAYWRIGHT_SKIP_WEBSERVER=1

# Solo desarrollo: login demo offline (admin@grooflow.com / 123456)
# VITE_ALLOW_DEMO_LOGIN=true
